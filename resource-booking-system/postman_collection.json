{
  "info": {
    "name": "Resource Booking System",
    "description": "JWT-secured RESTful API for booking resources (rooms, vehicles, equipment).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "resourceId", "value": "1" },
    { "key": "reservationId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('userToken', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"user\",\n  \"password\": \"User@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List Resources (paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/resources?page=0&size=10&sort=id,asc"
          }
        },
        {
          "name": "Get Resource by Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/resources/{{resourceId}}"
          }
        },
        {
          "name": "Create Resource (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Conference Room C\",\n  \"type\": \"ROOM\",\n  \"description\": \"Standup room\",\n  \"location\": \"Floor 1\",\n  \"capacity\": 6,\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/api/resources"
          }
        },
        {
          "name": "Update Resource (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Conference Room C - Renamed\",\n  \"type\": \"ROOM\",\n  \"description\": \"Updated\",\n  \"location\": \"Floor 1\",\n  \"capacity\": 8,\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/api/resources/{{resourceId}}"
          }
        },
        {
          "name": "Delete Resource (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/resources/{{resourceId}}"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation (USER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": {{resourceId}},\n  \"startTime\": \"2026-09-01T10:00:00\",\n  \"endTime\": \"2026-09-01T12:00:00\",\n  \"price\": 49.99,\n  \"notes\": \"Team sync\"\n}"
            },
            "url": "{{baseUrl}}/api/reservations"
          }
        },
        {
          "name": "List My Reservations (USER, filtered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations?status=PENDING&minPrice=10&maxPrice=100&page=0&size=10&sort=startTime,desc"
          }
        },
        {
          "name": "List All Reservations (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations?page=0&size=20"
          }
        },
        {
          "name": "Get Reservation by Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          }
        },
        {
          "name": "Update Reservation Status (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/status"
          }
        },
        {
          "name": "Cancel My Reservation (USER or ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel"
          }
        },
        {
          "name": "Delete Reservation (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          }
        }
      ]
    }
  ]
}
