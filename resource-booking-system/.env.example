# Copy this file to .env (or export these in your shell) and adjust values as needed.

# ---- Which database profile to use: "postgres" or "mysql" ----
SPRING_PROFILES_ACTIVE=postgres

# ---- Database connection ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_system
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- JPA ----
# update  -> auto-creates/updates tables (good for local dev, used by default)
# validate -> only validates schema, no changes (recommended once you use migrations in prod)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---- JWT ----
# Must be a Base64-encoded string that decodes to at least 256 bits (32 bytes) for HS256.
# Generate one with: openssl rand -base64 32
JWT_SECRET=c2VjcmV0LWtleS1mb3ItZGV2LWVudmlyb25tZW50LW9ubHktcGxlYXNlLWNoYW5nZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Ng==
JWT_EXPIRATION_MS=86400000

# ---- Server ----
SERVER_PORT=8080
